<div class="nauren-roll-card nrc-speech-card nc2">
  <header class="nrc-toggle nrc-no-details">
    <span class="nc-retrato"><img class="nrc-icon" src="{{#if icon}}{{icon}}{{else}}icons/svg/d20-highlight.svg{{/if}}" alt="{{actorName}}"></span>
    <div class="nc-balao">
      <div class="nrc-title-block">
        <span class="nrc-title">{{actorName}}</span>
        <span class="nrc-actor"><span class="nrc-player"><i class="nc-ponto" style="background: {{playerColor}};"></i>{{playerName}}</span></span>
      </div>
      <div class="nrc-description nrc-description-direta">{{{texto}}}</div>
    </div>
  </header>
</div>
