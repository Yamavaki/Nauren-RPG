<div class="nauren-roll-card nrc-speech-card" style="border-color: {{playerColor}};">
  <header class="nrc-toggle nrc-no-details" style="border-left: 4px solid {{playerColor}};">
    <img class="nrc-icon" src="{{#if icon}}{{icon}}{{else}}icons/svg/d20-highlight.svg{{/if}}" alt="{{actorName}}">
    <div class="nrc-title-block">
      <span class="nrc-title">{{actorName}}</span>
      <span class="nrc-actor"><span class="nrc-player" style="color: {{playerColor}};">{{playerName}}</span></span>
    </div>
  </header>
  <div class="nrc-description nrc-description-direta">{{{texto}}}</div>
</div>
